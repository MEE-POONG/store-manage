# ---- Hostname routing ----
# เดโมบนเครื่อง: store-management.localhost:3000 และ <slug>.localhost:3000
# โปรดักชัน: เปลี่ยนเป็นโดเมนจริง เช่น tech.com
NEXT_PUBLIC_ROOT_DOMAIN=localhost
NEXT_PUBLIC_MARKETING_SUBDOMAIN=store-management

# ---- Database (ยังไม่ใช้ในเดโม: ตอนนี้เก็บที่ data/db.json) ----
DATABASE_URL=postgresql://user:password@localhost:5432/sabaipos

# ---- Payment ----
# เดโมใช้ mock gateway; ใส่ค่าเหล่านี้เมื่อต่อ Omise/Stripe จริง
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change-me
OMISE_PUBLIC_KEY=pkey_test_xxx
OMISE_SECRET_KEY=skey_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
